# Copy these into Railway > your service > Variables. Never put real secrets in this file.
NODE_ENV=production
# Twitch console > your extension > Extension Settings > Extension Client Secret (the base64 text)
TWITCH_EXTENSION_SECRET=
# Twitch console > Extension Settings > Client ID
TWITCH_EXTENSION_CLIENT_ID=
# Optional (shows real Twitch names): Twitch console > Extension Settings > Extension Client Secret is NOT this.
# Make an app in dev.twitch.tv/console/apps and paste its Client Secret here.
TWITCH_API_CLIENT_SECRET=
# Your Railway address, e.g. https://challengelive-production.up.railway.app
PUBLIC_URL=
# Where data is saved. Add a Railway Volume mounted at /data, then:
DATA_FILE=/data/challengelive.json
# mock = simple keyword checker. anthropic = real AI check (needs ANTHROPIC_API_KEY)
MODERATION_PROVIDER=mock
ANTHROPIC_API_KEY=
